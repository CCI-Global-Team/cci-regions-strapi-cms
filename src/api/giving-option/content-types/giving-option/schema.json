{
  "kind": "collectionType",
  "collectionName": "giving_options",
  "info": {
    "singularName": "giving-option",
    "pluralName": "giving-options",
    "displayName": "GivingOption"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "order": {
      "type": "biginteger",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "enum": [
        "redirect",
        "sms",
        "bank_transfer",
        "contact",
        "informational"
      ]
    },
    "isPrimary": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": false
    },
    "accountName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "accountNumber": {
      "type": "biginteger",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iban": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sortCode": {
      "type": "biginteger",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "swiftCode": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "routingNumber": {
      "type": "biginteger",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "actionValue": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "actionUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "instructions": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bank": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::bank.bank"
    },
    "paymentProcessor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment-processor.payment-processor"
    },
    "campus": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::campus.campus",
      "inversedBy": "givingOptions"
    }
  }
}
