      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true
    },
    "country": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": "Canada",
      "enum": [
        "Australia",
        "Canada",
        "Nigeria",
        "United States of America",
        "United Kingdom"
      ]
    },
    "googleMapUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
