{
  "kind": "collectionType",
  "collectionName": "event_details",
  "info": {
    "singularName": "event-detail",
    "pluralName": "event-details",
    "displayName": "EventDetail"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "EventDetails",
      "required": false
    },
    "event": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::event.event",
      "mappedBy": "event_detail"
    },
    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "event.event-hero",
      "repeatable": false,
      "required": true
    },
    "engage": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "event.event-engage",
      "repeatable": false
    },
    "resources": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "event.event-info-coming-soon",
        "event.event-info-brochure"
      ]
    },
    "faqs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq.faq",
      "mappedBy": "event_detail"
    },
    "faqsSection": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "section.fa-qs",
      "repeatable": false
    }
  }
}
