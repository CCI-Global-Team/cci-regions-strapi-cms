    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "section.hero",
      "repeatable": false
    },
    "details": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "section.contact",
      "repeatable": false,
      "required": true
    },
    "planYourVisit": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "section.plan-your-visit",
      "repeatable": false
    }
  }
