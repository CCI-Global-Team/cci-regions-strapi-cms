{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "sunday_service",
        "midweek_service",
        "tarry",
        "reboot_camp",
        "deeper",
        "algorithm",
        "apostolic_visit",
        "endless_life",
        "meet_and_greet",
        "refresh",
        "others"
      ]
    },
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "url": {
      "type": "string"
    },
    "registrationUrl": {
      "type": "string"
    },
    "bannerImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    }
  }
}
